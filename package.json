  },
  "homepage": "https://github.com/Singer133/pi-dsh-supervisor#readme",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test": "npm run test:node && npm run test:powershell && npm run test:public && npm run test:package",
    "test:node": "node --test test/*.test.mjs",
    "test:powershell": "pwsh -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File test/run-dsh-smoke.ps1",
    "test:public": "node scripts/public-scan.mjs",
    "test:package": "node scripts/package-smoke.mjs"
  },
