{
  "name": "pi-dsh-supervisor",
  "version": "0.1.0",
  "description": "Windows-first Pi bridge for isolated DeepSeek Harness calls, health probes, process cleanup, and review-safe exports.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Singer133/pi-dsh-supervisor.git"
  },
  "bugs": {
